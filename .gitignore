# Virtual environment
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS
.DS_Store

# Logs
*.log

# Secrets — NEVER commit these
.env
.env.*
!.env.example
rzp-key*.csv
**/rzp-key*.csv

# Firebase service account keys
*adminsdk*.json
*service-account*.json
firebase-credentials.json

# AHA user data (keys, license, config)
# These live in ~/.aha/ at runtime; nothing to commit here
*.aha_license
*.aha_config

# Staged binaries for Nuitka bundling (generated on build machine)
vendor/tesseract/

# Build / dist
dist/
build/
*.egg-info/

# Customer zips / DMGs — build locally, upload to Supabase (never commit)
downloads/*.zip
downloads/*.dmg

# Nuitka crash diagnostics (local only)
nuitka-crash-report.xml

# Release work folders — nested clone / venv (never commit)
macos/.venv/
macos/.git/
windows/.git/

# Local dev / vision experiments (do not ship)
vision_debug_crops/
vision_test_result.png
test_ai_vision.py
test_gemini.py

# Duplicate scan copies — canonical code is aha/
storage files/
.vercel

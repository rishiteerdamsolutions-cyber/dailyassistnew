# ────────────────────────────────────────────────────────
# AHA Chrome Extension Backend — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────
# Your Firebase / GCP project ID (found in Firebase console → Project settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Absolute path to your Firebase service account key JSON file.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json

# ── Razorpay ──────────────────────────────────────────────
# The webhook secret configured in Razorpay Dashboard → Webhooks → Secret
# The webhook secret configured in Razorpay Dashboard → Webhooks → Secret
# Used for HMAC-SHA256 verification of incoming webhook payloads.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Razorpay API credentials (Dashboard → Settings → API Keys)
# key_id is safe to expose client-side; key_secret must NEVER go to the frontend.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Include your dashboard domain AND the chrome-extension:// origin of your extension.
# Example: https://dashboard.aha.ai,chrome-extension://abcdefghijklmnopqrstuvwxyz123456
ALLOWED_ORIGINS=https://your-dashboard.example.com,chrome-extension://your_extension_id

# ── Server ────────────────────────────────────────────────
# Port the uvicorn server listens on.
BACKEND_PORT=8000

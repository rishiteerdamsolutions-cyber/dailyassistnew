# ─────────────────────────────────────────────────────────────────────────────
# AHA — Environment variables template
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Tier-2 AI keys (BYOK — users can also set these in the companion Settings) ──
BOL_GEMINI_API_KEY=
BOL_OPENAI_API_KEY=

# ── Firebase (server-side token verification) ────────────────────────────────
# Option A: path to the downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=assist-daily-firebase-adminsdk-fbsvc-6e2f5d3e18.json

# Option B (Vercel / production): paste the ENTIRE downloaded .json as ONE line.
# Must include "type":"service_account", "project_id", "private_key", "client_email", etc.
# Do NOT paste only -----BEGIN PRIVATE KEY----- — that causes "No such file or directory" errors.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"assist-daily",...}

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xzgxzwueztsjwtortays.supabase.co
SUPABASE_ANON_KEY=
# Service role key — bypasses RLS, never expose to client
SUPABASE_SERVICE_KEY=

# ── Razorpay (subscriptions — test keys from dashboard or rzp-key CSV) ───────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Optional webhook signing secret (Razorpay Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Use 100 for ₹1 test charges during development
# AHA_PLAN_CORE_MONTHLY_PAISE=100
# AHA_PLAN_CORE_YEARLY_PAISE=100

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Comma-separated Firebase emails allowed to view analytics and manage coupons
AHA_ADMIN_EMAILS=you@example.com
# Optional API secret (header X-AHA-Admin-Secret) for scripts — never expose to browser
# AHA_ADMIN_SECRET=
